create database task2;
use task2;

create table employees (id int, name varchar(50), age int, department varchar(15), salary int);

create table students (student_id int, student_name varchar(15), course varchar(20), marks int);


1.DDL (Data Definition Language) – Structure of Database

alter table employees add email varchar(50);
alter table employees modify salary decimal(10,2);
alter table employees rename column name to employee_name;
alter table employees drop column age;
rename table students to College_students;
truncate table employees;
select * from employees;
drop table College_students;
select * from College_students;


