use pt;
select s.name,c.coursename from student s inner join course c on s.courseid=c.courseid;
select s.name,c.coursename,c.fee from student s inner join course c on s.courseid=c.courseid;
select s.name,f.facultyname from student s inner join faculty f on s.courseid=f.courseid;

select s.name,c.coursename from student s left join course c on s.courseid=c.courseid;
select c.coursename,s.name from course c left join student s on c.courseid=s.courseid;

select c.coursename,s.name from course c right join student s on c.courseid=s.courseid;

select s.name,c.coursename from student s left join course c on s.courseid=c.courseid 
union
select s.name,c.coursename from student s right join course c on s.courseid=c.courseid;

select s.name,c.coursename,f.facultyname from student s inner join course c on s.courseid=c.courseid 
inner join faculty f on s.courseid=f.courseid;
select s.name,c.coursename,f.facultyname from student s inner join course c on s.courseid=c.courseid 
inner join faculty f on s.courseid=f.courseid where c.coursename='Java';
select s.name,c.coursename,f.facultyname from student s inner join course c on s.courseid=c.courseid 
inner join faculty f on s.courseid=f.courseid where f.facultyname='John';

select s.name,c.coursename,c.fee from student s inner join course c on s.courseid=c.courseid where c.fee>30000;
select s.name,c.coursename,c.fee,c.duration from student s inner join course c on s.courseid=c.courseid where c.duration>90;

select s.*, c.coursename from student s join course c on s.courseid = c.courseid order by c.coursename;
select f.facultyname, count(s.studentid) as total_students from faculty f join student s on f.courseid = s.courseid
group by f.facultyid, f.facultyname;
select c.coursename, count(s.studentid) as total_students from course c left join student s on c.courseid = s.courseid
group by c.courseid, c.coursename order by total_students desc limit 1;



