-- 1. create student table with primary key
create table student1 (studentid int primary key,name varchar(50),age int,city varchar(50),courseid int,marks int);

-- 2. create course table with unique coursename
create table course1 (courseid int primary key,coursename varchar(50) unique,duration int,fee int);

-- 3. make student name not null
create table student2 (studentid int primary key,name varchar(50) not null,age int,city varchar(50),courseid int,marks int);

-- 4. check marks between 0 and 100
create table student3 (studentid int primary key,name varchar(50) not null,age int,city varchar(50),courseid int,marks int check (marks between 0 and 100));

-- 5. set default city as chennai
create table student4 (studentid int primary key,name varchar(50) not null,age int,city varchar(50) default 'Chennai',courseid int,marks int);

-- 6. add foreign key between student and course
create table course2 (courseid int primary key,coursename varchar(50),duration int,fee int);
create table student5 (studentid int primary key,name varchar(50) not null,age int,city varchar(50) default 'Chennai',courseid int,
	marks int check (marks between 0 and 100),
	foreign key (courseid) references course2(courseid));

